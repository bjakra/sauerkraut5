# Where the fork's builds look for their updates, and how they know them (tools/linux/gpu-rootfs.sh
# sets these in the daemon it builds). A release of the fork is signed with the private half of
# SK5_RELEASE_KEY (the SK5_SIGNING_KEY secret), as TECHO5's are with its own; a build of the fork never
# takes TECHO5's releases, nor a TECHO5 build the fork's: its root filesystem is published under its own
# key (arm-$SK5_BOARD_ROOTFS, update.rootfsArch).
SK5_RELEASES=https://github.com/bjakra/sauerkraut5/releases
SK5_RELEASE_KEY=Pa4ncjtZN4OCpfln24sX8rlHM9EDTi8e0oLr+t4DHS0=
SK5_BOARD_ROOTFS=checkers-gpu
